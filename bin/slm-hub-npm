#!/usr/bin/env node
/** Forward CLI arguments to the package-local Python installation. */

'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawnSync } = require('child_process');

const packageRoot = path.resolve(__dirname, '..');
const python = os.platform() === 'win32'
    ? path.join(packageRoot, '.slm-hub-venv', 'Scripts', 'python.exe')
    : path.join(packageRoot, '.slm-hub-venv', 'bin', 'python');

if (!fs.existsSync(python)) {
    console.error('SLM MCP Hub is not installed. Reinstall without --ignore-scripts.');
    process.exit(1);
}

const result = spawnSync(
    python,
    ['-m', 'slm_mcp_hub.cli.main', ...process.argv.slice(2)],
    { stdio: 'inherit', env: process.env },
);

if (result.error) {
    console.error(`Could not start SLM MCP Hub: ${result.error.message}`);
    process.exit(1);
}
process.exit(result.status === null ? 1 : result.status);
